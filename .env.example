# Copy to .env and fill in. Node 22 loads it with: node --env-file=.env src/server.js
PORT=3000
NODE_ENV=development

# Required in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Where the SQLite file lives (default: ./data/gamerslounge.db)
# DB_PATH=./data/gamerslounge.db

# Admin account created on first run if no admin exists yet.
# Without these, a dev-only admin (admin@gamerslounge.dev / admin12345) is created outside production.
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Only needed if your front end runs on a different origin, e.g. VS Code Live Server
# CORS_ORIGIN=http://127.0.0.1:5500

# Folder of static front-end files to serve (default: ./public)
# PUBLIC_DIR=./public
